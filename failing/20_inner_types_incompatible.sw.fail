message: incompatible types: required Map<Int, Vec<Bool, 10>, 30>, encountered IntVectors
---

type IntVectors = [Int : Vec<Int;10>  ;30]

struct Game {
    something:    [Int : Vec<Bool;10>  ;30],
}

impl Game {
    fn new(other_map: IntVectors) -> Game {
        Game {
            // Equal capacities isolate incompatible nested element types: Int vs Bool.
            something: other_map,
        }
    }
}

Game::new( [ 2: [99, 80] ] )
