enum BasicEnum {
    First
    Second Int
}

#[test]
fn simple_enum_to_string() {
    a := BasicEnum::Second(2).string()
    assert(a == "BasicEnum::Second(2)", "incorrect")
}


struct SimpleStruct {
    i: Int
    x: Float
}

#[test]
fn simple_struct_to_string() {
    a: SimpleStruct = {
        i: 42
        x: -1.1
    }

    s := a.string()

    print('s: "{s}"')
    assert(s == "SimpleStruct { i: 42, x: -1.100 }", "incorrect")
}


#[test]
fn simple_tuple_to_string() {
    s := (42, 99).string()

    print('s: "{s}"')
    assert(s == "(42, 99)", "incorrect")
}

struct InnerStruct {
    s: String<32>
    f: Float
}


struct SubStruct {
    i: Int
    inner: InnerStruct
}

#[test]
fn substruct_to_string() {
    s := SubStruct {
        i: -1
        inner: {
            s: "hello, world"
            f: 42.42
        }
    }.string()

    print('s: "{s}"')
    assert(
        s == "SubStruct { i: -1, inner: InnerStruct { s: \"hello, world\", f: 42.420 } }"
        "incorrect"
    )
}

