#[test]
fn simple_vec() {
    a := [2, 3, 4].string()

    print('a {a}')
    assert(a == "[ 2, 3, 4 ]", "incorrect")
}


#[test]
fn simple_vec_struct() {
    a: Vec<SimpleStruct; 32> = [
        {
            i: 10
            x: 20.0
        }
        {
            i: 30
            x: 40.0
        }
    ]

    s := a.string()

    print('s {s}')
    assert(
        s == "[ SimpleStruct { i: 10, x: 20.000 }, SimpleStruct { i: 30, x: 40.000 } ]"
        "incorrect"
    )
}


#[test]
fn simple_map_struct() {
    a: [Int : SimpleStruct; 32] = [
        2: {
            i: 10
            x: 20.0
        }
        3: {
            i: 30
            x: 40.0
        }
    ]

    s := a.string()

    print('s {s}')
    assert(
        s == "[ 2 : SimpleStruct { i: 10, x: 20.000 }, 3 : SimpleStruct { i: 30, x: 40.000 } ]"
        "incorrect"
    )
}

#[test]
fn simple_map_enum() {
    a: [Int : BasicEnum; 32] = [2: BasicEnum::Second(2), 3: BasicEnum::First]

    s := a.string()

    print('s {s}')
    assert(
        s == "[ 2 : BasicEnum::Second(2), 3 : BasicEnum::First ]"
        "incorrect"
    )
}


struct CustomStruct {
    i: Int
    x: Float
}

impl CustomStruct {
    fn string(self) -> String {
        'so cool i:{.i}'
    }
}

#[test]
fn custom() {
    a: [Int : CustomStruct; 32] = [
        2: CustomStruct {
            i: 20
            x: 40.0
        }
        3: CustomStruct {
            i: 30
            x: 50.0
        }
    ]

    s := a.string()

    print('s {s}')
    assert(s == "[ 2 : so cool i:20, 3 : so cool i:30 ]", "incorrect")
}


#[test]
fn custom_empty() {
    a: [Int : CustomStruct; 32]

    s := a.string()

    print('s {s}')
    assert(s == "[:]", "incorrect")
}

#[test]
fn custom_empty_interpolate() {
    a: [Int : CustomStruct; 32]

    print('s {a}')
}

type UserID = String<64>

#[test]
fn user_id_string_no_qoutes() {
    user_id: UserID = "debug|-1"
    assert(user_id.string() == "debug|-1", "UserID.string() added quotes")
}

#[test]
fn user_id_interpolation_no_qoutes() {
    user_id: UserID = "debug|-1"
    plain_id: String<64> = "debug|-1"
    assert('user:{plain_id}' == "user:debug|-1", "plain string key changed")
    assert(
        'user:{user_id}' == 'user:{plain_id}'
        "UserID interpolation added quotes"
    )
}

type WrappedUserID = UserID
type UserIDView = String

struct UserIDField {
    user_id: UserID
}

#[test]
fn user_id_nested_wrapper_no_quotes() {
    user_id: WrappedUserID = "debug|-1"
    assert(
        user_id.string() == "debug|-1"
        "nested UserID.string() added quotes"
    )
    assert(
        'user:{user_id}' == "user:debug|-1"
        "nested UserID interpolation added quotes"
    )
}

#[test]
fn standalone_string_conversion_no_quotes() {
    stored: String<64> = "debug|-1"
    view: String = stored
    wrapped_view: UserIDView = view
    assert(
        stored.string() == "debug|-1"
        "string storage conversion added quotes"
    )
    assert(view.string() == "debug|-1", "string view conversion added quotes")
    assert(
        wrapped_view.string() == "debug|-1"
        "distinct string view conversion added quotes"
    )
}

#[test]
fn user_id_field_formatting_keeps_quotes() {
    value := UserIDField {
        user_id: "debug|-1"
    }
    assert(
        value.string() == "UserIDField { user_id: \"debug|-1\" }"
        "string field must remain quoted"
    )
}