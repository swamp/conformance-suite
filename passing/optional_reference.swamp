#[test]
fn check_map_lookup() {
    map := [ 1 : 2 ]

    maybe_value := map[1]?

    result := when maybe_value {
        maybe_value
    } else {
        0
    }

    assert(result == 2, 'result: {result}')
}


#[test]
fn check_map_value() {
    map := [ 1 : 42 ]

    result := when v = map[1]? {
        v
    } else {
        0
    }

    assert(result == 42, 'result: {result}')
}


#[test]
fn check_missing_map_value() {
    map := [1: 0]

    result := when _v = map[2]? {
        1
    } else {
        0
    }

    assert(result == 0, 'result: {result}')
}

struct Point {
    x: Int
    y: Int
}

#[test]
fn check_map_aggregate_loopkup() {
    map := [ 1 : Point { x: 10, y: 20 } ]

    maybe_value := map[1]?

    result := when maybe_value {
        maybe_value.y
    } else {
        0
    }

    assert(result == 20, 'result: {result}')
}


#[test]
fn check_map_value_aggregate() {
    map := [ 1 : Point { x: 10, y: 42 } ]

    result := when point = map[1]? {
        print('found it: {point}')
        point.y
    } else {
        0
    }

    assert(result == 42, 'result: {result}')
}

#[test]
fn check_missing_map_aggregate_value() {
    map := [ 1 : Point { x: 10, y: 42 } ]

    result := when _v = map[2]? {
        1
    } else {
        0
    }

    assert(result == 0, 'result: {result}')
}


#[test]
fn check_missing_vec_aggregate_value() {
    vec := [ Point { x: 10, y: 42 } ]

    result := when _v = vec[1]? {
        1
    } else {
        0
    }

    assert(result == 0, 'result: {result}')
}


#[test]
fn check_existing_vec_aggregate_value() {
    vec := [ Point { x: 10, y: 42 } , Point { x: 20, y: 48 } ]

    result := when v = vec[1]? {
        v.x
    } else {
        0
    }

    assert(result == 20, 'result: {result}')
}

#[test]
fn check_existing_pool_aggregate_value() {
    mut pool : Pool<Point; 8>

    id := pool.add(Point {
        x: 10
        y: 20
    })

    result := when v = pool[id]? {
        v.x
    } else {
        0
    }

    assert(result == 10, 'result: {result}')
}


#[test]
fn check_missing_pool_aggregate_value() {
    mut pool : Pool<Point; 8> = []

    id := pool.add(Point {
        x: 10
        y: 20
    })

    result := when v = pool[id+1]? {
        v.x
    } else {
        0
    }

    assert(result == 0, 'result: {result}')
}
