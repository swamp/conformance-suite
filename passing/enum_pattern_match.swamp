enum Direction {
    North
    South
    East
    West
}

enum Message {
    Quit
    Move(Int, Int)
    Write(Int)
    Position { x: Int, y: Int }
}

// Basic discriminant check with single and tuple payload variant
#[test]
fn is_variant_with_payload() {
    a := Message::Move(10, 20)
    assert(a == Move(_), "should match Move variant")
    assert(a == Move(_, _), "should match tuple payload variant")
    assert(a == Message::Move(_), "qualified variant should match Move")
    assert(a == Message::Move(_, _), "qualified tuple payload should match Move")
}

// Basic discriminant check with anonymous struct payload variant
#[test]
fn is_struct_variant() {
    a := Message::Position { x: 10, y: 20 }
    assert(a == Position { _ }, "should match struct payload variant")
    assert(a == Message::Position { _ }, "qualified struct variant should match")
}

// != check
#[test]
fn is_not_variant() {
    a := Message::Quit
    assert(a != Move(_), "Quit should not match Move")
    assert(a != Message::Move(_), "Quit should not match qualified Move")
}

// Unit variant (no payload) — just use == directly, no wildcard needed
#[test]
fn unit_variant_match() {
    d := Direction::North
    assert(d == North, "should match North")
    assert(d != South, "should not match South")
}

// Used as if condition
#[test]
fn if_pattern_match() {
    a := Message::Write(99)
    result := if a == Write(_) { 1 } else { 0 }
    assert(result == 1, "should enter then branch")
}

// if / else if chain
#[test]
fn if_else_if_chain() {
    a := Direction::East
    result := if a == North {
        0
    } else if a == East {
        1
    } else {
        2
    }
    assert(result == 1, "should match East")
}

// Wrong variant does not match
#[test]
fn wrong_variant_no_match() {
    a := Message::Move(3, 4)
    result := if a == Write(_) { 1 } else { 0 }
    assert(result == 0, "Move should not match Write")

    qualified_result := if a == Message::Write(_) { 1 } else { 0 }
    assert(qualified_result == 0, "should not match")
}
