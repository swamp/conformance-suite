/// Thanks to @catnipped who found the bug
struct Decklist {
    cards: Vec<Int; 32>
}

struct DraftSimulation {
    deck_list: Vec<Int; 16> // Intentionally another capacity than the Decklist
}

enum Screen {
    Draft { draft_sim: DraftSimulation }
    SomethingElse
}

#[test]
fn match_with_optional() {

    screen := Screen::Draft {
        draft_sim: DraftSimulation {
            deck_list: [10, 20, 30]
        }
    }

    draft_decklist: Decklist? = match screen {
        Draft { draft_sim } -> { cards: draft_sim.deck_list } 
        _ -> none
    }

    assert(draft_decklist, 'draft decklist should be true (Some)')
}

struct Payload {
    i: Bool
    c: Int
    b: Float
}

enum DeclarationOrder {
    Empty
    Payload Payload
}


// Found by @catnipped
// Patterns mistakingly was using anonymous field index instead of declaration index if the payload is a named struct.
#[test]
fn match_declaration_order() {
    scrutinee := DeclarationOrder::Payload({ i: false, c: 10, b: 0.3 })

    match scrutinee {
        Payload { b, c } -> {
            assert(c == 10, 'c should be correct {c}')
            assert(b == 0.3, 'b should be correct {b}')
        }
    }
}