struct Player {
    assigned_ship: Int?
}

#[test]
fn when_using_scalar() {
    player := Player {
        assigned_ship: 42
    }

    when ship_id=player.assigned_ship {
        assert(ship_id == 42, 'ship_id should be 42 but is {ship_id}')
        print('ship_id: {ship_id}')
    } else {
        panic('player.assigned_ship should not be None')
    }
}

struct Position {
    x: Int
    y: Int
}

enum SomeEnum {
    VariantFirst
    AnotherThing { f: Float, position: Position }
    Third
}

#[test]
fn when_using_enum() {
    e := SomeEnum::AnotherThing { f: 2.0, position: [30, 40 ] }

    when AnotherThing { position } = e {
        print('it worked: {position}')
        assert(position.y  == 40, 'should work {position}')
    } else {
        panic('should not reach here')
    }
}


#[test]
fn when_using_enum_no_bindings() {
    e : SomeEnum = AnotherThing { f: 2.0, position: [30, 40 ] }

    when AnotherThing { _ } = e {
        print('it worked:}')
    } else {
        panic('should not reach here')
    }
}